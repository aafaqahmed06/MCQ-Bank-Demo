# Copy to .env.local and fill in real values. NEVER commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CAPTCHA (Cloudflare Turnstile). Site key is public (client-side); the
# secret is server-side only and must also be set on the hosted Supabase
# project's Dashboard (Authentication -> Attack Protection) since GoTrue,
# not this app's own server, is what calls Turnstile's siteverify.
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret-key
