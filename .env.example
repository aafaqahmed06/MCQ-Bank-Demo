# Copy to .env.local and fill in real values. NEVER commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CAPTCHA (optional -- unset means signup/sign-in/forgot-password work as
# today, with no captcha widget rendered). Set both to enable, matching the
# provider in supabase/config.toml's [auth.captcha] block.
# NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=your-site-key
